CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
NEXT_PUBLIC_CASHFREE_MODE=sandbox
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Cashfree return_url must be https (used when APP_URL is http/localhost)
CASHFREE_RETURN_BASE_URL=https://creatordrop.in

# Optional: separate R2 bucket with NO public custom domain (recommended)
# R2_PRIVATE_BUCKET=store-private
# Optional dedicated secret for download tokens (falls back to ADMIN_SECRET)
# DOWNLOAD_TOKEN_SECRET=

MONGODB_URI=mongodb://user:pass@host:27111/?authSource=admin&directConnection=true
MONGODB_DB=supercreator

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_SECRET=generate-a-long-random-string

DO_MODEL_ACCESS_KEY=
R2_PUBLIC_BASE_URL=https://store.creatordrop.in
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=https://store.creatordrop.in
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=store
# Bucket with NO public custom domain — delivery PDFs only
R2_PRIVATE_BUCKET=creatordrop-private
# Optional dedicated secret for download tokens (falls back to ADMIN_SECRET)
# DOWNLOAD_TOKEN_SECRET=